humbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/4/42/This_Tanker_Must_Be_Replaced_Art.IWMPST14038.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":2382},"url":"https://upload.wikimedia.org/wikipedia/commons/4/42/This_Tanker_Must_Be_Replaced_Art.IWMPST14038.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:This_Tanker_Must_Be_Replaced_Art.IWMPST14038.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=30837541","extmetadata":{"DateTime":{"value":"2014-02-08 08:45:07","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"This Tanker Must Be Replaced Art.IWMPST14038","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"World War II posters from the United Kingdom|Images uploaded by F\u00e6|Artworks without Wikidata item|UK Government artistic works|PD-scan (PD-UKGov)|1944 posters of the United Kingdom|Her Majesty's Stationery Office Collection|Shipbuilding in the United Kingdom in World War II","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\nUnknown (artist), Admiralty (publisher/sponsor), Multi Machine Plates Ltd, London EC4 (printer), Her Majesty's Stationery Office (publisher/sponsor)</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<i>This Tanker Must Be Replaced</i><br>\n<p>whole: the image is positioned in the upper two-thirds, with the Admiralty seal placed in the upper left. The title and\ntext are separate and placed in the lower third, in white, and in black held within a red inset, set against a black\nbackground.\nimage: an overhead depiction of a burning oil tanker at sea, billowing large clouds of black smoke.\ntext: SIG OFF MAG ADM MAG BRIT [Translation: Official Seal of His Britannic Majesty's Admiralty]\nTHIS TANKER\nMUST be replaced\nOIL is the life-blood of the services!\nP D 2/3/44\nPRINTED FOR H.M. STATIONERY OFFICE BY MULTI MACHINE PLATES LTD. LONDON E.C.4.\n51-4906\n</p>\nISSUED BY THE ADMIRALTY","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1944 (Second World War)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"http://media.iwm.org.uk/iwm/mediaLib//156/media-156439/large.jpg\">http://media.iwm.org.uk/iwm/mediaLib//156/media-156439/large.jpg</a><div style=\"margin:0.5em\"></div>\n<div class=\"center centered\" style=\"width:auto\">\n<table style=\"width:100%; border:1px solid var(--border-color-notice,black); background:var(--background-color-neutral,#E0E0E0); padding:0; text-align:center; color:inherit\">\n<tbody><tr>\n<td align=\"left\"><span typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/File:IWMLondonThumbnail.jpg\" class=\"mw-file-description\" title=\"Image of the exterior main entrance to the Imperial War Museum in London.\"><img alt=\"\" src=\"https://upload.wikimedia.org/wikipedia/commons/c/c3/IWMLondonThumbnail.jpg?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"54\" class=\"mw-file-element\" data-file-width=\"80\" data-file-height=\"54\"></a></span>\n</td>\n<td>This photograph <a rel=\"nofollow\" class=\"external text\" href=\"https://www.iwm.org.uk/collections/item/object/31900\">Art.IWM PST 14038</a> comes from the collections of the <a rel=\"nofollow\" class=\"external text\" href=\"https://www.iwm.org.uk\">Imperial War Museums</a>.\n</td>\n<td align=\"right\"><span typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/File:Flag_of_the_United_Kingdom_(3-5).svg\" class=\"mw-file-description\" title=\"Flag of the United Kingdom.\"><img alt=\"\" src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Flag_of_the_United_Kingdom_%283-5%29.svg/120px-Flag_of_the_United_Kingdom_%283-5%29.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"80\" height=\"48\" class=\"mw-file-element\" srcset=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Flag_of_the_United_Kingdom_%283-5%29.svg/250px-Flag_of_the_United_Kingdom_%283-5%29.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"600\"></a></span>\n</td></tr></tbody></table></div>","source":"commons-desc-page"},"Permission":{"value":"This poster was scanned and released by the Imperial War Museum on the <a rel=\"nofollow\" class=\"external text\" href=\"http://www.iwm.org.uk/corporate/privacy-copyright/licence\">IWM Non Commercial Licence</a>. The artwork was created by a commissioned military artist during their active service duties in the First World War. In the UK this these became controlled under the Crown Copyright provisions and so faithful reproductions may be reused under that licence, which is considered expired after 50 years.","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]}}}}