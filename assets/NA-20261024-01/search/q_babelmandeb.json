:{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"S66-54536 (14 Sept. 1966) --- Arabian Peninsula (on left) and northeast Africa (on right) as seen from the orbiting Gemini-11 spacecraft at an altitude of 340 nautical miles during its 27th revolution of Earth, looking southeast. Saudi Arabia, South Arabia, Yemen, and Aden Protectorate are at left. At bottom right is Ethiopia. French Somaliland is in center on right shore. Somali is at upper right. Body of water at bottom is Red Sea. Gulf of Aden is in center; and at top left is Indian Ocean. Taken with a modified 70mm Hasselblad camera, using Eastman Kodak, Ektachrome, MS (S.O. 368) color film.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1966-09-14","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://spaceflight.nasa.gov/gallery/images/gemini/gemini11/html/s66-54536.html\" href=\"https://spaceflight.nasa.gov/gallery/images/gemini/gemini11/html/s66-54536.html\">http://spaceflight.nasa.gov/gallery/images/gemini/gemini11/html/s66-54536.html</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]}}}}